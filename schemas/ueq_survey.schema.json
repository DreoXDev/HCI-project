{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEQ/NPS survey row",
  "type": "object",
  "required": ["user_id", "app", "Q01", "Q02", "Q03", "Q04", "Q05", "Q06", "Q07", "Q08", "Q09", "Q10", "Q11", "Q12", "Q13", "Q14", "Q15", "Q16", "Q17", "Q18", "Q19", "Q20", "Q21", "Q22", "Q23", "Q24", "Q25", "Q26", "nps"],
  "properties": {
    "user_id": {"type": "string", "minLength": 1},
    "app": {"type": "string"},
    "nps": {"type": ["integer", "number"], "minimum": 0, "maximum": 10},
    "qualitative_notes": {"type": "string"}
  },
  "patternProperties": {
    "^Q(0[1-9]|1[0-9]|2[0-6])$": {"type": ["integer", "number"], "minimum": 1, "maximum": 7}
  }
}
